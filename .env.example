# Supabase (create a project at https://supabase.com and copy from Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (https://aistudio.google.com/apikey) — use a key that is on the zero-retention tier.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-exp

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
